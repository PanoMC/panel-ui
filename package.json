{
  "name": "pano-panel-ui",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env DEV=true vite dev --host=0.0.0.0 --port=3001",
    "dev:ui": "concurrently \"bun run watch:ui\" \"bun run dev\"",
    "watch:ui": "sass src/styles/style.scss static/style.css --watch --load-path=. --load-path=node_modules --quiet-deps --no-source-map",
    "build:ui": "sass src/styles/style.scss static/style.css --load-path=. --load-path=node_modules --quiet-deps --no-source-map",
    "prebuild": "bun node_modules/@panomc/theme-core/bin/generate-runtime-shims.js",
    "build": "cross-env DEV=false vite build",
    "postinstall": "bun node_modules/@panomc/theme-core/bin/bundle-internal-libs.js && bun node_modules/@panomc/theme-core/bin/generate-runtime-shims.js",
    "preview": "cross-env DEV=false vite preview ",
    "lint": "npm-run-all -c lint:*",
    "lint:prettier": "prettier -c . --config .prettierrc",
    "format": "npm-run-all -c format:*",
    "format:prettier": "prettier --write . --config .prettierrc",
    "generate-licenses": "node node_modules/@panomc/theme-core/bin/generate-licenses.js",
    "bundle:libs": "bun node_modules/@panomc/theme-core/bin/bundle-internal-libs.js"
  },
  "husky": {
    "hooks": {}
  },
  "devDependencies": {
    "@jill64/universal-sanitizer": "^1.4.6",
    "@panomc/sdk": "file:./theme-core/packages/sdk",
    "@panomc/theme-core": "file:./theme-core/packages/theme-core",
    "@rollup/plugin-json": "^6.1.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tiptap/pm": "^3.22.4",
    "adm-zip": "^0.5.17",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "cookie": "^1.1.1",
    "copy-to-clipboard": "^3.3.3",
    "cross-env": "^10.1.0",
    "csrf": "^3.1.0",
    "date-fns": "^4.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte3": "^4.0.0",
    "marked": "^18.0.2",
    "mime-types": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "sass": "^1.99.0",
    "svelte": "5.55.4",
    "svelte-i18n": "^4.0.1",
    "svelte-preprocess": "^6.0.3",
    "tippy.js": "^6.3.7",
    "uuid": "^14.0.0",
    "vite": "^8.0.9"
  },
  "type": "module",
  "dependencies": {
    "@appnest/masonry-layout": "^2.2.3",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-color": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-text-style": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "animate.css": "^4.1.1",
    "canvas-confetti": "^1.9.4",
    "confetti": "^3.0.4",
    "popper.js": "^1.16.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.8"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "es5-ext",
    "esbuild",
    "svelte-preprocess"
  ]
}
