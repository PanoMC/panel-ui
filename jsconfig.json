{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "$app/*": [
        ".svelte/dev/runtime/app/*",
        ".svelte/build/runtime/app/*"
      ],
      "$lib": [
        "src/lib"
      ],
      "$lib/*": [
        "src/lib/*"
      ]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "theme-core/packages/sdk/src/**/*.js"
  ],
  "extends": "./.svelte-kit/tsconfig.json"
}
